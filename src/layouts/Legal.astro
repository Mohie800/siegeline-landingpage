---
import Base from './Base.astro';
import { AR_LEGAL_READY, localizedPath, type Locale } from '../config';
import { t } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  updated: string;
  lang: Locale;
  path: string;
}

const { title, description, updated, lang, path } = Astro.props;

const updatedLabel = new Intl.DateTimeFormat(lang === 'ar' ? 'ar' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(updated));
---

<Base title={`${title} — SIEGELINE`} description={description} lang={lang} path={path}>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6 sm:py-20">
    <header class="border-b border-line/70 pb-6">
      <h1 class="font-display text-3xl text-white sm:text-4xl">{title}</h1>
      <p class="mt-3 text-sm text-muted">
        {t(lang, 'legal.updated')}: <time datetime={updated}>{updatedLabel}</time>
      </p>
      {
        lang === 'ar' && AR_LEGAL_READY && (
          <p class="mt-2 text-sm text-muted/80">{t(lang, 'legal.canonical')}</p>
        )
      }
    </header>

    <div class="prose mt-10">
      <slot />
    </div>

    <footer class="mt-14 border-t border-line/70 pt-6">
      <a
        href={localizedPath('/', lang)}
        class="text-sm text-gold underline underline-offset-4 hover:text-white"
      >
        ← {t(lang, 'legal.back')}
      </a>
    </footer>
  </article>
</Base>
