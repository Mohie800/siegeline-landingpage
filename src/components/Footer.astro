---
import { SITE, localizedPath, legalPath, AR_READY, type Locale } from '../config';
import { t } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const year = new Date().getFullYear();
const other: Locale = lang === 'en' ? 'ar' : 'en';
const otherLabel = lang === 'en' ? 'العربية' : 'English';
---

<footer class="border-t border-line/70 bg-ink-2">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <div class="flex flex-col gap-8 sm:flex-row sm:justify-between">
      <div class="max-w-xs">
        <p class="font-display text-lg text-gold">{lang === 'ar' ? SITE.nameAr : SITE.name}</p>
        <p class="mt-2 text-sm text-muted">
          {lang === 'ar' ? SITE.taglineAr : SITE.tagline}
        </p>
        <p class="mt-3 text-xs leading-relaxed text-muted/90">
          {t(lang, 'footer.about')}
        </p>
        {
          AR_READY && (
            <a
              href={localizedPath('/', other)}
              class="mt-4 inline-block rounded-lg border border-line px-3 py-1.5 text-sm text-muted transition hover:border-gold/60 hover:text-text"
              lang={other}
            >
              {otherLabel}
            </a>
          )
        }
      </div>

      <nav class="text-sm" aria-label={t(lang, 'footer.legal')}>
        <p class="font-display text-xs tracking-widest text-muted uppercase">
          {t(lang, 'footer.legal')}
        </p>
        <ul class="mt-3 space-y-2">
          <li>
            <a href={legalPath('/privacy', lang)} class="text-muted transition hover:text-text">
              {t(lang, 'footer.privacy')}
            </a>
          </li>
          <li>
            <a href={legalPath('/terms', lang)} class="text-muted transition hover:text-text">
              {t(lang, 'footer.terms')}
            </a>
          </li>
          <li>
            <a
              href={legalPath('/account-deletion', lang)}
              class="text-muted transition hover:text-text"
            >
              {t(lang, 'footer.deletion')}
            </a>
          </li>
          <li>
            <a href={legalPath('/support', lang)} class="text-muted transition hover:text-text">
              {t(lang, 'footer.support')}
            </a>
          </li>
        </ul>
      </nav>

      <div class="text-sm">
        <p class="font-display text-xs tracking-widest text-muted uppercase">
          {t(lang, 'footer.contact')}
        </p>
        <a
          href={`mailto:${SITE.supportEmail}`}
          class="mt-3 inline-block text-gold underline underline-offset-4 hover:text-white"
        >
          {SITE.supportEmail}
        </a>
      </div>
    </div>

    <div class="mt-10 border-t border-line/60 pt-6 text-xs text-muted">
      <p>© {year} {SITE.studio}. {t(lang, 'footer.rights')}</p>
      <p class="mt-1">{t(lang, 'footer.disclaimer')}</p>
    </div>
  </div>
</footer>
