---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import shotBase from '../assets/screens/base.png';
import shotTier3 from '../assets/screens/tier3.png';
import shotScouting from '../assets/screens/scouting.png';
import PlayBadge from './PlayBadge.astro';
import { type Locale } from '../config';
import { t } from '../i18n/ui';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const pillars = [
  { title: t(lang, 'game.p1.title'), body: t(lang, 'game.p1.body') },
  { title: t(lang, 'game.p2.title'), body: t(lang, 'game.p2.body') },
  { title: t(lang, 'game.p3.title'), body: t(lang, 'game.p3.body') },
];

const shots = [
  { src: shotBase, caption: t(lang, 'screens.shot1') },
  { src: shotTier3, caption: t(lang, 'screens.shot2') },
  { src: shotScouting, caption: t(lang, 'screens.shot3') },
];
---

<!-- hero -->
<section class="relative overflow-hidden">
  <div class="hero-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="mx-auto max-w-6xl px-4 pt-16 pb-20 text-center sm:px-6 sm:pt-24 sm:pb-28">
    <p class="font-display text-xs tracking-[0.25em] text-cyan uppercase sm:text-sm">
      {t(lang, 'hero.kicker')}
    </p>

    <Image
      src={logo}
      alt={t(lang, 'home.title')}
      width={760}
      densities={[1, 2]}
      loading="eager"
      fetchpriority="high"
      class="mx-auto mt-6 w-full max-w-lg drop-shadow-[0_10px_40px_rgba(247,201,72,0.25)] sm:max-w-xl"
    />

    <h1 class="font-display mt-8 text-2xl leading-tight text-balance text-white sm:text-4xl">
      {t(lang, 'hero.tagline')}
    </h1>
    <p class="mx-auto mt-4 max-w-xl text-base text-pretty text-muted sm:text-lg">
      {t(lang, 'hero.blurb')}
    </p>

    <div class="mt-9 flex flex-col items-center gap-3">
      <PlayBadge lang={lang} />
      <p class="text-xs tracking-wide text-muted">{t(lang, 'cta.android')}</p>
    </div>
  </div>
</section>

<!-- pillars -->
<section id="game" class="border-t border-line/60 bg-ink-2/60 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="font-display text-xs tracking-[0.25em] text-cyan uppercase">
      {t(lang, 'game.eyebrow')}
    </p>
    <h2 class="font-display mt-3 text-2xl text-white sm:text-3xl">{t(lang, 'game.title')}</h2>

    <div class="mt-10 grid gap-5 sm:grid-cols-3">
      {
        pillars.map((p, i) => (
          <article class="rounded-2xl border border-line/80 bg-panel/60 p-6 transition hover:border-gold/50">
            <span class="font-display text-3xl text-gold/70">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-display mt-3 text-lg text-white">{p.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{p.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- screenshots -->
<section id="screens" class="py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <p class="font-display text-xs tracking-[0.25em] text-cyan uppercase">
      {t(lang, 'screens.eyebrow')}
    </p>
    <h2 class="font-display mt-3 text-2xl text-white sm:text-3xl">{t(lang, 'screens.title')}</h2>

    <div class="mt-10 space-y-8">
      {
        shots.map((shot, i) => (
          <figure class="overflow-hidden rounded-2xl border border-line/80 bg-panel/40">
            <Image
              src={shot.src}
              alt={shot.caption}
              widths={[640, 960, 1280, 1600]}
              sizes="(min-width: 1024px) 1024px, 100vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              class="w-full"
            />
            <figcaption class="border-t border-line/60 px-5 py-4 text-sm text-muted">
              {shot.caption}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <p class="mt-6 text-xs text-muted/80">{t(lang, 'screens.note')}</p>
  </div>
</section>

<!-- progression -->
<section class="border-t border-line/60 bg-ink-2/60 py-16 sm:py-24">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:items-center">
    <div>
      <p class="font-display text-xs tracking-[0.25em] text-cyan uppercase">
        {t(lang, 'meta.eyebrow')}
      </p>
      <h2 class="font-display mt-3 text-2xl text-white sm:text-3xl">{t(lang, 'meta.title')}</h2>
      <p class="mt-4 text-base leading-relaxed text-muted">{t(lang, 'meta.body')}</p>
    </div>

    <ul class="space-y-4">
      {
        [t(lang, 'meta.li1'), t(lang, 'meta.li2'), t(lang, 'meta.li3')].map((line) => (
          <li class="flex gap-3 rounded-xl border border-line/70 bg-panel/50 p-4 text-sm text-muted">
            <span class="mt-0.5 text-gold" aria-hidden="true">
              ◆
            </span>
            <span>{line}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<!-- fair play / closing CTA -->
<section class="py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 text-center sm:px-6">
    <h2 class="font-display text-2xl text-gold sm:text-3xl">{t(lang, 'fair.title')}</h2>
    <p class="mt-4 text-base leading-relaxed text-pretty text-muted">{t(lang, 'fair.body')}</p>
    <p class="mt-3 text-sm text-muted/80">{t(lang, 'fair.lang')}</p>
    <div class="mt-8 flex justify-center">
      <PlayBadge lang={lang} />
    </div>
  </div>
</section>
