---
import { SITE, PLAY_URL, type Locale } from '../config';
import { t } from '../i18n/ui';

interface Props {
  lang: Locale;
  size?: 'sm' | 'lg';
  class?: string;
}
const { lang, size = 'lg', class: klass = '' } = Astro.props;

const dims = size === 'lg' ? 'px-6 py-3.5 text-base gap-3' : 'px-3.5 py-2 text-sm gap-2';
const icon = size === 'lg' ? 20 : 15;

// A plain play triangle, not Google's four-colour mark — see README "Before launch":
// the official "Get it on Google Play" badge artwork replaces this before the button
// ever links to a live listing.
const GLYPH = 'M8 5.14v13.72a1 1 0 0 0 1.52.86l11.14-6.86a1 1 0 0 0 0-1.72L9.52 4.28A1 1 0 0 0 8 5.14Z';
---

{
  SITE.playLive ? (
    <a
      href={PLAY_URL}
      class={`inline-flex items-center rounded-xl bg-gold font-bold text-ink shadow-lg shadow-gold/20 transition hover:bg-white ${dims} ${klass}`}
    >
      <svg
        width={icon}
        height={icon}
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        class="shrink-0 rtl:-scale-x-100"
      >
        <path d={GLYPH} />
      </svg>
      {t(lang, 'cta.get')}
    </a>
  ) : (
    <span
      class={`inline-flex items-center rounded-xl border border-gold/40 bg-gold/10 font-bold text-gold ${dims} ${klass}`}
    >
      <svg
        width={icon}
        height={icon}
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        class="shrink-0 rtl:-scale-x-100"
      >
        <path d={GLYPH} />
      </svg>
      {t(lang, 'cta.soon')}
    </span>
  )
}
