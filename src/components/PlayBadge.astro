---
import { SITE, PLAY_URL, type Locale } from '../config';
import { t } from '../i18n/ui';

interface Props {
  lang: Locale;
  size?: 'sm' | 'lg';
  class?: string;
}
const { lang, size = 'lg', class: klass = '' } = Astro.props;

const dims =
  size === 'lg' ? 'px-6 py-3.5 text-base gap-3' : 'px-3.5 py-2 text-sm gap-2';
const icon = size === 'lg' ? 22 : 17;
---

{
  SITE.playLive ? (
    <a
      href={PLAY_URL}
      class={`inline-flex items-center rounded-xl bg-gold font-bold text-ink shadow-lg shadow-gold/20 transition hover:bg-white ${dims} ${klass}`}
    >
      <svg width={icon} height={icon} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M3.6 1.9a1 1 0 0 0-.5.9v18.4a1 1 0 0 0 .5.9l10.2-10.1L3.6 1.9Zm11.6 8.6 2.9-2.9-11-6.3 8.1 9.2Zm0 3 8.1 9.2 11-6.3-2.9-2.9-16.2 0Z" transform="scale(0.75) translate(2 2)" />
      </svg>
      {t(lang, 'cta.get')}
    </a>
  ) : (
    <span
      class={`inline-flex items-center rounded-xl border border-gold/40 bg-gold/10 font-bold text-gold ${dims} ${klass}`}
    >
      <svg width={icon} height={icon} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M3.6 1.9a1 1 0 0 0-.5.9v18.4a1 1 0 0 0 .5.9l10.2-10.1L3.6 1.9Zm11.6 8.6 2.9-2.9-11-6.3 8.1 9.2Zm0 3 8.1 9.2 11-6.3-2.9-2.9-16.2 0Z" transform="scale(0.75) translate(2 2)" />
      </svg>
      {t(lang, 'cta.soon')}
    </span>
  )
}
