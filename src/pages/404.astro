---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
---

<Base title={`${t('en', '404.title')} — SIEGELINE RIVALS`} description={t('en', '404.body')} lang="en" path="/404">
  <section class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6 sm:py-32">
    <p class="font-display text-6xl text-gold">404</p>
    <h1 class="font-display mt-4 text-2xl text-white">{t('en', '404.title')}</h1>
    <p class="mt-3 text-muted">{t('en', '404.body')}</p>
    <a
      href="/"
      class="mt-8 inline-block rounded-xl bg-gold px-5 py-3 font-bold text-ink transition hover:bg-white"
      >{t('en', 'legal.back')}</a
    >
  </section>
</Base>
